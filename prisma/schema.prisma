// Prisma schema.
//
// The datasource is SQLite because that is what Cloudflare D1 is. The
// portability rules below were written when this ran on a local SQLite file
// and a move to PostgreSQL looked likely; landing on D1 instead means they
// cost nothing and the schema needed no rewrite at all. Keep to them:
//   - no `enum` blocks (SQLite has none) -> plain String columns whose allowed
//     values live in data/posts.js and data/users.js, so there is one source of
//     truth the UI and the API both read from.
//   - no `@db.Text` (SQLite has none) -> plain String, which Prisma already
//     maps to `text` on PostgreSQL anyway, so nothing is lost.
//   - no scalar lists (SQLite has none) -> see Post.topics.
//   - no relations, and so no nested writes. This one is now load-bearing:
//     D1 has no transactions, so Prisma would silently run the statements of
//     an implicit transaction individually. Adding a relation means giving up
//     atomicity without being told. Check that trade before you add one.
//
// There is no `url` here: Prisma 7 removed it from the datasource block. The
// connection arrives instead as the D1 binding handed to the adapter in
// lib/prisma.ts, and prisma.config.ts tells the CLI where to look.

generator client {
  // The new `prisma-client` generator, not the legacy `prisma-client-js`.
  // Prisma 7 compiles queries with a WebAssembly module, and Workers refuses
  // `new WebAssembly.Module(bytes)` at runtime ("Wasm code generation
  // disallowed by embedder") - the wasm has to arrive as a static import
  // instead. Only this generator, told to target workerd, emits that.
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

// Admin/editor accounts for the newsroom back office.
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String // bcrypt hash - never a plaintext password
  role      String   @default("EDITOR") // see ROLES in data/users.js
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Statements and articles share one table: they carry the same core fields
// (title, slug, date, body, topics) and the newsroom hub lists them together.
// `type` selects which template renders it and which of the type-specific
// field groups below apply.
model Post {
  id      String @id @default(cuid())
  type    String // 'STATEMENT' | 'ARTICLE' - see POST_TYPES in data/posts.js
  title   String
  slug    String @unique
  summary String // card excerpt and og:description; keep it press-quotable
  body    String // Markdown

  status      String    @default("DRAFT") // 'DRAFT' | 'PUBLISHED'
  publishedAt DateTime? // set when first published; drives ordering

  // SQLite has no array type, so topics are stored as a delimited string.
  // Always read/write this through the helpers in lib/posts.ts rather than
  // touching the raw column, so the delimiters stay consistent.
  topics String @default("")

  coverImageUrl String?

  // Article-only. An article is an opinion piece and carries a byline; an
  // external submission additionally shows the "views are the author's own"
  // disclaimer so a submission is never mistaken for an MAI position.
  authorName           String?
  authorTitle          String?
  authorPhotoUrl       String?
  isExternalSubmission Boolean @default(false)

  // Statement-only. A statement speaks for the organisation, so it gets an
  // issuing body instead of a byline, plus the things press need: a stable
  // reference to quote and an optional PDF on letterhead.
  issuedBy      String?
  referenceCode String?
  pdfUrl        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([type, status, publishedAt])
  @@index([status, publishedAt])
}

// ---------------------------------------------------------------------------
// Pre-existing models, carried over unchanged apart from the SQLite-safe
// rewrites described at the top (enum -> String, @db.Text -> String).
// ---------------------------------------------------------------------------

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  date        DateTime
  startTime   DateTime
  endTime     DateTime?
  location    String?
  imageUrl    String?
  category    String // GENERAL | EDUCATIONAL | YOUTH | COMMUNITY | RELIGIOUS | CHARITY
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
}

model Media {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String
  type        String // IMAGE | VIDEO
  category    String // EVENT | GALLERY | FACILITY | GENERAL
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Facility {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("PENDING") // PENDING | RESPONDED | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)
  priority  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
